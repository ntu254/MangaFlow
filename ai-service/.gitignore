# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# AI Model weights (too large for git — download separately or use HuggingFace Hub)
models/yolo11/*.pt        # YOLO11 manga109 instance seg checkpoint
models/yolo/*.pt
models/checkpoints/
!models/.gitkeep
!models/yolo/.gitkeep
!models/yolo11/.gitkeep

# Logs
logs/
*.log

# Testing
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Runtime directories (keep .gitkeep, ignore actual files)
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# MinIO / Storage data (local dev volumes)
data/
storage/local/

# Celery
celerybeat-schedule
celerybeat.pid
