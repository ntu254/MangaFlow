# Copy this file to mobile/.env before running Expo.
# EXPO_PUBLIC_* values are bundled into the app; do not put private production secrets here.

# Backend API. Use 10.0.2.2 for an Android emulator when the backend runs on the host.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Optional demo accounts used by the quick-login buttons and API read fallback.
EXPO_PUBLIC_BOARD_EMAIL=board@beachread.jp
EXPO_PUBLIC_BOARD_PASSWORD=board@beachread.jp
EXPO_PUBLIC_EDITOR_EMAIL=editor@mangaflow.local
EXPO_PUBLIC_EDITOR_PASSWORD=editor@mangaflow.local

# Set true only when local mock fallback is explicitly wanted.
EXPO_PUBLIC_ENABLE_MOBILE_MOCK_FALLBACK=false
