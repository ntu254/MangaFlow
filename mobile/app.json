{
  "expo": {
    "name": "MangaFlow Mobile",
    "slug": "mangaflow-mobile",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "mangaflow",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}

